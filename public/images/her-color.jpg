<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="100%" height="100%">
  <defs>
    <!-- Background Gradient: Festive blue party tinsel vibe -->
    <linearGradient id="bgWall" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E0E7FF" />
      <stop offset="50%" stop-color="#EFF6FF" />
      <stop offset="100%" stop-color="#DBEAFE" />
    </linearGradient>

    <!-- Metallic Blue Tinsel Streamers -->
    <linearGradient id="tinselGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1D4ED8" />
      <stop offset="30%" stop-color="#60A5FA" />
      <stop offset="70%" stop-color="#2563EB" />
      <stop offset="100%" stop-color="#1E40AF" />
    </linearGradient>

    <!-- Balloon Gradient -->
    <radialGradient id="balloonGrad" cx="35%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="60%" stop-color="#F1F5F9" />
      <stop offset="100%" stop-color="#CBD5E1" />
    </radialGradient>

    <!-- Skin Gradient -->
    <linearGradient id="skinTone" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FDE8D7" />
      <stop offset="100%" stop-color="#F9CDAD" />
    </linearGradient>

    <!-- Krishu's Blue Birthday Dress -->
    <linearGradient id="blueDressGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#BFDBFE" />
      <stop offset="50%" stop-color="#93C5FD" />
      <stop offset="100%" stop-color="#60A5FA" />
    </linearGradient>

    <!-- Hair Gradient -->
    <linearGradient id="darkHair" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E1B1E" />
      <stop offset="50%" stop-color="#2D2529" />
      <stop offset="100%" stop-color="#131013" />
    </linearGradient>

    <!-- Cake Frosting Gradient (White to Lavender) -->
    <linearGradient id="cakeFrosting" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="50%" stop-color="#F5F3FF" />
      <stop offset="100%" stop-color="#EDE9FE" />
    </linearGradient>

    <!-- Lavender Rosettes Gradient -->
    <linearGradient id="lavenderSwirl" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C4B5FD" />
      <stop offset="100%" stop-color="#8B5CF6" />
    </linearGradient>

    <!-- Gold Cake Topper -->
    <linearGradient id="goldTopper" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDE047" />
      <stop offset="50%" stop-color="#EAB308" />
      <stop offset="100%" stop-color="#CA8A04" />
    </linearGradient>

    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#1E3A8A" flood-opacity="0.15" />
    </filter>
  </defs>

  <!-- Wall Background -->
  <rect width="400" height="500" fill="url(#bgWall)" />

  <!-- Blue Metallic Tinsel Backdrop Curtains -->
  <g opacity="0.85">
    <rect x="70" y="40" width="8" height="260" fill="url(#tinselGrad)" />
    <rect x="85" y="40" width="6" height="260" fill="url(#tinselGrad)" opacity="0.9" />
    <rect x="100" y="40" width="7" height="260" fill="url(#tinselGrad)" />
    <rect x="115" y="40" width="8" height="260" fill="url(#tinselGrad)" opacity="0.8" />
    <rect x="130" y="40" width="6" height="260" fill="url(#tinselGrad)" />
    <rect x="145" y="40" width="8" height="260" fill="url(#tinselGrad)" opacity="0.9" />
    <rect x="250" y="40" width="8" height="260" fill="url(#tinselGrad)" opacity="0.9" />
    <rect x="265" y="40" width="7" height="260" fill="url(#tinselGrad)" />
    <rect x="280" y="40" width="8" height="260" fill="url(#tinselGrad)" opacity="0.85" />
    <rect x="295" y="40" width="6" height="260" fill="url(#tinselGrad)" />
    <rect x="310" y="40" width="9" height="260" fill="url(#tinselGrad)" />
    <rect x="325" y="40" width="7" height="260" fill="url(#tinselGrad)" opacity="0.9" />
  </g>

  <!-- Silver "Happy Birthday" Foil Banner Letters Behind -->
  <g opacity="0.45" stroke="#FFFFFF" stroke-width="1.5" fill="none">
    <path d="M100 80 Q200 95 300 80" />
    <text x="135" y="88" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="14" fill="#93C5FD">H A P P Y</text>
    <text x="215" y="88" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="14" fill="#93C5FD">B D A Y</text>
  </g>

  <!-- White Party Balloons at the Top -->
  <circle cx="50" cy="15" r="55" fill="url(#balloonGrad)" opacity="0.95" />
  <circle cx="160" cy="-5" r="50" fill="url(#balloonGrad)" opacity="0.95" />
  <circle cx="250" cy="10" r="55" fill="url(#balloonGrad)" opacity="0.95" />
  <circle cx="350" cy="-10" r="60" fill="url(#balloonGrad)" opacity="0.95" />
  <!-- Small Blue Accent Balloon -->
  <circle cx="140" cy="45" r="28" fill="#3B82F6" opacity="0.85" />

  <!-- Back Hair -->
  <path d="M125 150 C110 200 115 270 135 340 C160 360 240 360 265 340 C285 270 290 200 275 150 Z" fill="url(#darkHair)" />

  <!-- Krishu's Blue Birthday Dress (Sweetheart neckline & bell sleeves) -->
  <path d="M110 500 C110 390 145 350 200 350 C255 350 290 390 290 500 Z" fill="url(#blueDressGrad)" filter="url(#softGlow)" />
  <!-- Bell / Flutter Sleeves -->
  <path d="M120 370 C95 400 80 450 75 500 L125 500 C130 450 140 400 145 375 Z" fill="#93C5FD" opacity="0.9" />
  <path d="M280 370 C305 400 320 450 325 500 L275 500 C270 450 260 400 255 375 Z" fill="#93C5FD" opacity="0.9" />

  <!-- Neck & Shoulders -->
  <path d="M175 250 L175 350 Q200 360 225 350 L225 250 Z" fill="url(#skinTone)" />
  <!-- Dainty Gold Necklace -->
  <path d="M178 300 Q200 318 222 300" fill="none" stroke="#EAB308" stroke-width="1.2" />
  <circle cx="200" cy="311" r="2" fill="#EAB308" />

  <!-- Krishu's Face -->
  <path d="M145 160 C145 110 165 95 200 95 C235 95 255 110 255 160 C255 215 230 255 200 255 C170 255 145 215 145 160 Z" fill="url(#skinTone)" filter="url(#softGlow)" />

  <!-- Soft Cheerful Blush Cheeks -->
  <ellipse cx="166" cy="195" rx="14" ry="9" fill="#FB7185" opacity="0.38" />
  <ellipse cx="234" cy="195" rx="14" ry="9" fill="#FB7185" opacity="0.38" />

  <!-- Left Eyebrow -->
  <path d="M160 156 Q174 150 186 156" fill="none" stroke="#2D2529" stroke-width="2.5" stroke-linecap="round" />
  <!-- Right Eyebrow -->
  <path d="M214 156 Q226 150 240 156" fill="none" stroke="#2D2529" stroke-width="2.5" stroke-linecap="round" />

  <!-- Joyful Crinkling Eyes (Happy Birthday Laugh/Smile) -->
  <path d="M162 170 Q173 162 184 170" fill="none" stroke="#1E1B1E" stroke-width="3" stroke-linecap="round" />
  <path d="M183 167 L187 164" stroke="#1E1B1E" stroke-width="1.8" stroke-linecap="round" />
  <path d="M216 170 Q227 162 238 170" fill="none" stroke="#1E1B1E" stroke-width="3" stroke-linecap="round" />
  <path d="M237 167 L241 164" stroke="#1E1B1E" stroke-width="1.8" stroke-linecap="round" />

  <!-- Nose -->
  <path d="M198 185 Q200 193 203 193" fill="none" stroke="#E11D48" stroke-width="1.8" opacity="0.5" stroke-linecap="round" />

  <!-- Playful Radiantly Joyful Open Smile with Teeth -->
  <path d="M180 212 Q200 236 220 212 Z" fill="#991B1B" />
  <path d="M184 213 Q200 221 216 213" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="2" />
  <!-- Tongue Accent from Photo -->
  <path d="M192 222 Q200 230 208 222 Z" fill="#F43F5E" />
  <path d="M178 212 Q200 238 222 212" fill="none" stroke="#881337" stroke-width="2.5" stroke-linecap="round" />

  <!-- Dark Hair Framing the Face & Shoulders -->
  <path d="M142 155 C142 105 165 75 200 75 C235 75 258 105 258 155 C258 180 252 205 248 230 C242 265 250 310 255 350 C245 355 235 340 232 310 C230 270 238 220 230 190 C225 170 215 155 200 155 C185 155 175 170 170 190 C162 220 170 270 168 310 C165 340 155 355 145 350 C150 310 158 265 152 230 Z" fill="url(#darkHair)" />

  <!-- Hair Curls Over Shoulders -->
  <path d="M145 250 Q130 310 140 370" fill="none" stroke="#1E1B1E" stroke-width="12" stroke-linecap="round" />
  <path d="M255 250 Q270 310 260 370" fill="none" stroke="#1E1B1E" stroke-width="12" stroke-linecap="round" />

  <!-- Krishu's Arms & Hands Holding Cake -->
  <path d="M125 430 C125 450 145 470 175 470" fill="none" stroke="url(#skinTone)" stroke-width="18" stroke-linecap="round" />
  <path d="M275 430 C275 450 255 470 225 470" fill="none" stroke="url(#skinTone)" stroke-width="18" stroke-linecap="round" />

  <!-- Big Round Birthday Cake Held at Center-Bottom -->
  <g transform="translate(200, 440)" filter="url(#softGlow)">
    <!-- Gold Cake Board -->
    <ellipse cx="0" cy="22" rx="145" ry="25" fill="#EAB308" stroke="#CA8A04" stroke-width="2" />

    <!-- Cake Body (Frosted with white & lavender vertical streaks) -->
    <path d="M-135 0 L-135 20 C-135 35 135 35 135 20 L135 0 Z" fill="url(#cakeFrosting)" stroke="#DDD6FE" stroke-width="1" />
    <!-- Lavender Frosted Vertical Streaks from Photo -->
    <path d="M-110 5 L-105 22" stroke="#C4B5FD" stroke-width="8" stroke-linecap="round" opacity="0.75" />
    <path d="M-70 2 L-65 24" stroke="#A78BFA" stroke-width="9" stroke-linecap="round" opacity="0.65" />
    <path d="M-20 0 L-15 25" stroke="#C4B5FD" stroke-width="8" stroke-linecap="round" opacity="0.7" />
    <path d="M30 0 L35 25" stroke="#A78BFA" stroke-width="9" stroke-linecap="round" opacity="0.65" />
    <path d="M80 5 L85 22" stroke="#C4B5FD" stroke-width="8" stroke-linecap="round" opacity="0.75" />

    <!-- Cake Top Surface -->
    <ellipse cx="0" cy="0" rx="135" ry="22" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" />

    <!-- Rosettes / Swirls Around Top Edge (Purple & Lavender) -->
    <circle cx="-110" cy="-6" r="10" fill="url(#lavenderSwirl)" />
    <circle cx="-90" cy="-12" r="11" fill="url(#lavenderSwirl)" />
    <circle cx="-65" cy="-16" r="11" fill="url(#lavenderSwirl)" />
    <circle cx="-40" cy="-18" r="10" fill="url(#lavenderSwirl)" />
    <circle cx="-15" cy="-19" r="10" fill="#DDD6FE" />
    <circle cx="15" cy="-19" r="10" fill="#DDD6FE" />
    <circle cx="40" cy="-18" r="10" fill="url(#lavenderSwirl)" />
    <circle cx="65" cy="-16" r="11" fill="url(#lavenderSwirl)" />
    <circle cx="90" cy="-12" r="11" fill="url(#lavenderSwirl)" />
    <circle cx="110" cy="-6" r="10" fill="url(#lavenderSwirl)" />

    <!-- White Whipped Cream Pearls on Front Rim -->
    <circle cx="-100" cy="5" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="-70" cy="11" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="-40" cy="15" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="-10" cy="17" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="20" cy="17" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="50" cy="15" r="5" fill="#FFFFFF" stroke="#F1F5F9" />
    <circle cx="80" cy="11" r="5" fill="#FFFFFF" stroke="#F1F5F9" />

    <!-- Pink Butterfly Accents on Cake -->
    <path d="M45 -8 Q50 -18 56 -10 Q50 -2 45 -8 Z" fill="#F472B6" />
    <path d="M57 -8 Q62 -18 68 -10 Q62 -2 57 -8 Z" fill="#F472B6" />

    <!-- Golden Acrylic "Happy Birthday" Cake Topper Stick & Script -->
    <line x1="-35" y1="2" x2="-35" y2="-30" stroke="#CA8A04" stroke-width="2.5" />
    <line x1="25" y1="2" x2="25" y2="-30" stroke="#CA8A04" stroke-width="2.5" />
    <rect x="-45" y="-45" width="85" height="24" rx="4" fill="url(#goldTopper)" stroke="#B45309" stroke-width="1.2" />
    <text x="-2" y="-30" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="9" fill="#78350F" letter-spacing="0.5">HAPPY BIRTHDAY</text>
  </g>

  <!-- Sparkles & Festive Accents -->
  <path d="M50 200 Q55 190 65 190 Q55 190 50 180 Q45 190 35 190 Q45 190 50 200 Z" fill="#FDE047" opacity="0.8" />
  <path d="M350 220 Q355 210 365 210 Q355 210 350 200 Q345 210 335 210 Q345 210 350 220 Z" fill="#FDE047" opacity="0.8" />
  <path d="M295 140 Q298 132 306 132 Q298 132 295 124 Q292 132 284 132 Q292 132 295 140 Z" fill="#60A5FA" opacity="0.9" />

  <!-- Bottom ID Card Tag -->
  <rect x="0" y="475" width="400" height="25" fill="#1E293B" opacity="0.75" />
  <text x="16" y="491" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="700" fill="#93C5FD" letter-spacing="1.5">OCTOBER 20 · KRISHU'S BIRTHDAY</text>
  <text x="384" y="491" text-anchor="end" font-family="'Dancing Script', cursive" font-size="14" font-weight="700" fill="#F472B6">happy birthday krishu</text>
</svg>
